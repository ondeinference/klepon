// Copy this file to Configs/Secrets.local.xcconfig (git-ignored)
// and fill in your Onde Cloud credentials for each platform.

// iOS
ONDE_APP_ID[sdk=iphoneos*] = your-ios-app-id
ONDE_APP_SECRET[sdk=iphoneos*] = your-ios-app-secret
ONDE_APP_ID[sdk=iphonesimulator*] = your-ios-app-id
ONDE_APP_SECRET[sdk=iphonesimulator*] = your-ios-app-secret

// tvOS
ONDE_APP_ID[sdk=appletvos*] = your-tvos-app-id
ONDE_APP_SECRET[sdk=appletvos*] = your-tvos-app-secret
ONDE_APP_ID[sdk=appletvsimulator*] = your-tvos-app-id
ONDE_APP_SECRET[sdk=appletvsimulator*] = your-tvos-app-secret

// macOS
ONDE_APP_ID[sdk=macosx*] = your-macos-app-id
ONDE_APP_SECRET[sdk=macosx*] = your-macos-app-secret

// visionOS
ONDE_APP_ID[sdk=xros*] = your-visionos-app-id
ONDE_APP_SECRET[sdk=xros*] = your-visionos-app-secret
ONDE_APP_ID[sdk=xrsimulator*] = your-visionos-app-id
ONDE_APP_SECRET[sdk=xrsimulator*] = your-visionos-app-secret
