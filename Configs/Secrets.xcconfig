// Onde Cloud credentials.
//
// Each Apple platform has its own Onde app with separate credentials.
// Create Configs/Secrets.local.xcconfig (git-ignored) with SDK-conditional
// values — see Secrets.local.xcconfig.example for the format.

#include? "Secrets.local.xcconfig"

// Self-referencing defaults: if Secrets.local.xcconfig provides a value for
// the current SDK, it wins; otherwise these resolve to empty strings and
// OndeGuideEngine shows a configuration error at runtime.
ONDE_APP_ID = $(ONDE_APP_ID)
ONDE_APP_SECRET = $(ONDE_APP_SECRET)
